datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AppRole {
  ADMIN
  USER
}

model Country {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String       @unique
  flagCode            String       @map("flag_code")
  description         String?
  isActive            Boolean      @default(true) @map("is_active")
  sortOrder           Int          @default(1) @map("sort_order")
  flagImageUrl        String?      @map("flag_image_url")
  universityCount     Int          @default(0) @map("university_count")
  expenseRange        String?      @map("expense_range")
  specialFeature      String?      @map("special_feature")
  tagline             String?
  heroImageUrl        String?      @map("hero_image_url")
  cardImageUrl        String?      @map("card_image_url")
  livingCost          String?      @map("living_cost")
  workRights          String?      @map("work_rights")
  visaInfo            String?      @map("visa_info")
  highlights          Json         @default("[]")
  whyChoose           Json         @default("[]")
  popularCourses      Json         @default("[]")
  intakes             Json         @default("[]")
  englishRequirements Json         @default("[]") @map("english_requirements")
  tuitionDetails      Json         @default("[]") @map("tuition_details")
  documentChecklist   Json         @default("{}") @map("document_checklist")
  specialNotes        Json         @default("[]") @map("special_notes")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  universities        University[]
  scholarships        Scholarship[]

  @@map("countries")
}

model University {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  countryId            String        @map("country_id") @db.Uuid
  tuitionFeeRange      String?       @map("tuition_fee_range")
  scholarshipAvailable Boolean       @default(false) @map("scholarship_available")
  requirements         String?
  logoUrl              String?       @map("logo_url")
  websiteUrl           String?       @map("website_url")
  isPartner            Boolean       @default(false) @map("is_partner")
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  country              Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  scholarships         Scholarship[]

  @@map("universities")
}

model EnglishTest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  testType    String   @default("exam") @map("test_type")
  fee         String?
  duration    String?
  isActive    Boolean  @default(true) @map("is_active")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("english_tests")
}

model Scholarship {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  countryId    String?     @map("country_id") @db.Uuid
  universityId String?     @map("university_id") @db.Uuid
  amount       String?
  deadline     String?
  eligibility  String?
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  country      Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@map("scholarships")
}

model Testimonial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  university String?
  country    String?
  flagCode   String?  @map("flag_code")
  quote      String?
  imageUrl   String?  @map("image_url")
  mediaType  String   @default("text") @map("media_type")
  mediaUrl   String?  @map("media_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("testimonials")
}

model Announcement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text      String
  linkUrl   String?  @map("link_url")
  linkText  String?  @map("link_text")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("announcements")
}

model Lead {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  phone       String
  destination String?
  course      String?
  status      String   @default("new")
  notes       String?
  leadType    String   @default("general") @map("lead_type")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("leads")
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String     @unique
  password  String     // bcrypt hash
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  roles     UserRole[]

  @@map("users")
}

model UserRole {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  role   AppRole

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model VisaApproval {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentName String   @map("student_name")
  country     String
  visaType    String?  @default("") @map("visa_type")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  flagUrl     String?  @map("flag_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("visa_approvals")
}
